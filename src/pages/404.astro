---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
import { getStudies, getNotes } from '../data/site-content';

const studies = await getStudies();
const notes = (await getNotes()).slice(0, 4);

const fmt = (dt: Date) =>
  dt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// Every top-level section, so recovery never depends on the browser back button.
const sections = [
  { href: '/', label: 'Home', desc: 'What we do, in one page' },
  { href: '/services', label: 'Services & pricing', desc: 'Four ways to work with us, from £450' },
  { href: '/work', label: 'Work', desc: 'Case studies, live in production' },
  { href: '/field-notes', label: 'Field notes', desc: "Notes from an AI-run business" },
  { href: '/about', label: 'About', desc: 'Who we are and how we run' },
  { href: '/contact', label: 'Contact', desc: 'Reach a human — one-week promise' },
];
---

<BaseLayout
  title="Page not found"
  description="This page has vanished — or never existed. Let's get you back to something real."
>
  <section class="notfound hatch">
    <div class="notfound__glow" aria-hidden="true"></div>
    <div class="wrap" style="position:relative; z-index:2;">
      <p class="sys sys--spectral" style="justify-content:center; display:inline-flex;">missing incantation</p>
      <h1 class="notfound__code">404</h1>
      <p class="notfound__msg">This spell fizzled.</p>
      <p class="notfound__sub">
        The server found no page at this address — it may have moved, been renamed, or never existed.
        Nothing is broken on your end. Everything below is real and reachable.
      </p>
      <div class="cta__ctas" style="margin-top: var(--sp-10)">
        <a href="/" class="btn"><span>Back to home</span></a>
        <a href="/work" class="btn btn--ghost"><span>See the work</span><span class="btn__arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- Recovery: every top-level section -->
  <section class="section on-near">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Where were you heading?</p>
        <h2>Every section, one click away.</h2>
      </div>
      <ul class="reveal" style="list-style:none; margin:0; padding:0; display:grid; gap:var(--sp-4);">
        {sections.map((s) => (
          <li style="display:flex; flex-wrap:wrap; align-items:baseline; gap:var(--sp-3);">
            <a href={s.href} class="tlink" style="font-size:var(--t-2); font-weight:600;">{s.label}</a>
            <span style="color:var(--muted);">— {s.desc}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Recovery: recent field notes -->
  <section class="section on-paper">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Fresh from field notes</p>
        <h2>Recently published.</h2>
      </div>
      <ul class="reveal" style="list-style:none; margin:0; padding:0; display:grid; gap:var(--sp-4);">
        {notes.map((n) => (
          <li style="display:flex; flex-wrap:wrap; align-items:baseline; gap:var(--sp-3);">
            <a href={`/field-notes/${n.id}`} class="tlink" style="font-weight:600;">{n.data.title}</a>
            <span style="color:var(--muted);">— {fmt(n.data.date)}</span>
          </li>
        ))}
      </ul>
      <p style="margin-top: var(--sp-6)">
        <a href="/field-notes" class="arrow-link">All field notes <span class="btn__arrow">→</span></a>
      </p>
    </div>
  </section>

  <!-- Recovery: case studies -->
  <section class="section on-near">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Proof over promises</p>
        <h2>Our case studies.</h2>
      </div>
      <ul class="reveal" style="list-style:none; margin:0; padding:0; display:grid; gap:var(--sp-4);">
        {studies.map((e) => (
          <li style="display:flex; flex-wrap:wrap; align-items:baseline; gap:var(--sp-3);">
            <a href={`/work/${e.id}`} class="tlink" style="font-weight:600;">{e.data.headline ?? e.data.title}</a>
            <span style="color:var(--muted);">— {e.data.sector}</span>
          </li>
        ))}
      </ul>
      <p style="margin-top: var(--sp-6)">
        <a href="/work" class="arrow-link">All work <span class="btn__arrow">→</span></a>
      </p>
    </div>
  </section>

  <!-- Recovery: contact route -->
  <section class="section on-dark cta hatch">
    <div class="cta__glow" aria-hidden="true"></div>
    <div class="wrap">
      <h2 class="cta__head">Still stuck?</h2>
      <p class="cta__body">
        Email <a href={`mailto:${business.email}`} class="tlink">{business.email}</a> or call
        <a href={`tel:${business.phoneTel}`} class="tlink">{business.phone}</a> (voicemail line — it reaches
        Waseem). A human reads everything.
      </p>
      <div class="cta__ctas">
        <a href="/contact" class="btn"><span>Contact us instead</span></a>
        <a href="/" class="btn btn--ghost"><span>Start over at home</span><span class="btn__arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
