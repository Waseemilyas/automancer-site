---
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { founderNode, organizationNode, websiteNode, webPageNode } from '../data/jsonld';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  ogType?: 'website' | 'article';
  /** Page-specific schema.org nodes merged into the shared @graph. */
  schema?: Record<string, unknown>[];
  /** WebPage subtype for structured data (ContactPage, AboutPage, …). */
  pageType?: string;
}

const { title, description, image, ogType = 'website', schema = [], pageType } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <SEO title={`${title} | Automancer`} description={description} image={image} type={ogType} />

    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16.png" />
    <link rel="icon" href="/assets/images/logo.svg" type="image/svg+xml" />

    <!-- Fonts: two display voices (Syne + JetBrains Mono machine voice),
         Space Grotesk for UI/body, Outfit for long-form reading. Weights
         trimmed to what the design actually uses; display=swap avoids FOIT.
         Self-hosted from our own origin (see public/assets/css/fonts.css) —
         no request ever leaves the visitor's browser to a third-party font
         host, so no visitor IP is shared with Google. -->
    <link rel="preload" href="/assets/fonts/space-grotesk-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/syne-800-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/css/fonts.css" />

    <!-- One JSON-LD @graph per page: Organization + WebSite + this page,
          plus the founder Person node (referenced by @id from the
          organization and article nodes, so it must be described here),
          plus any page-specific nodes passed via the `schema` prop. -->
    <JsonLd
      nodes={[
        organizationNode(),
        websiteNode(),
        webPageNode({ path: Astro.url.pathname, title, description, type: pageType }),
        founderNode(),
        ...schema,
      ]}
    />

    <!-- Page-specific extra <head> content: Article JSON-LD on field notes,
         the Turnstile script on the contact page, etc. -->
    <slot name="head" />

    {/*
      NO browser-storage writes here, deliberately. A UTM-capture snippet used
      to persist utm_* from the landing URL for the contact form to attribute
      the lead. Removed 2026-08-22 (AUT-6414, Waseem's call as data
      controller): /privacy tells visitors this site "stores nothing in your
      browser", and campaign attribution is not strictly necessary under PECR,
      so the snippet made that claim false and was never consented to. Keeping
      the claim literally true was judged worth more than the attribution.
      If campaign attribution is ever wanted again it needs a consent
      mechanism first — do not reinstate it as a bare snippet.
      tests/no-browser-storage.test.ts enforces this.

      This is a server-side comment on purpose: an HTML comment would ship the
      note to every page and put the very strings that test greps for back
      into the output.
    */}

    <!-- Production-only browser error monitoring. The module itself requires
         PUBLIC_AUT_SENTRY_WEB_DSN, so preview/dev builds never emit events. -->
    <script>
      import '../scripts/sentry';
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline src="/assets/js/main.js" defer></script>
  </body>
</html>
